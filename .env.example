# Copiar a .env y completar con los valores del proyecto de Supabase.
# Solo se exponen al browser las variables con prefijo VITE_.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# OJO: es la publishable/anon key, NO la service_role.
# El nombre es este, no VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=tu-publishable-key

# Opcional. Si es 'true', los admins tambien pueden entrar a torneos
# con status 'upcoming'. Cualquier otro valor lo deja desactivado.
VITE_ALLOW_UPCOMING_TOURNAMENTS_FOR_ADMINS=false
